# ─── Railway injects PORT automatically, jangan di-set manual ───
# PORT=3000

# ─── CORS: URL frontend kamu (Vercel), pisah koma kalau lebih dari satu ───
ORIGIN=https://your-app.vercel.app,http://localhost:5173

# ─── Upstash Redis (wajib) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ─── API Key untuk HTTP /emit endpoint ──────────────────────────
SOCKET_API_KEY=ganti-dengan-secret-key-yang-kuat
