# ─────────────────────────────────────────────────────────────────────────────
# BIZGROW — Environment Variables
# Copy ke .env dan isi semua value yang wajib
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Configuration ────────────────────────────────────────────────────────
ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,tauri://localhost
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:@localhost:3306/finance_engine_db

# Kalau pakai Docker MySQL:
# DATABASE_URL=mysql://bizgrow:changeme_in_production@mysql:3306/finance_engine_db

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-random-secret-min-32-characters-long

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Socket.io ────────────────────────────────────────────────────────────────
SOCKET_PORT=13337
SOCKET_API_PORT=13338
PUBLIC_SOCKET_URL=http://localhost:13337
SOCKET_SERVER_URL=http://localhost:13337
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCKET_API_KEY=your-socket-api-key-min-32-chars

# ─── Security Keys ────────────────────────────────────────────────────────────
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=your-csrf-secret-min-32-characters
ENCRYPTION_KEY=your-encryption-key-exactly-64-hex-chars-here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Dapatkan di: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-secret

# ─── Pusher (Legacy realtime — akan digantikan Socket.io) ─────────────────────
PUBLIC_PUSHER_KEY=your-pusher-key
PUBLIC_PUSHER_CLUSTER=ap1
PUSHER_APP_ID=your-pusher-app-id
PUSHER_SECRET=your-pusher-secret

# ─── AI — Groq ────────────────────────────────────────────────────────────────
# Dapatkan di: https://console.groq.com
# Free tier: 14.400 req/hari, cukup untuk development
GROQ_API_KEY=gsk_your-groq-api-key

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Dapatkan di: https://resend.com (free tier: 3.000 email/bulan)
RESEND_API_KEY=re_your-resend-api-key

# Dev: pakai onboarding@resend.dev (pre-verified, kirim ke email terdaftar Resend saja)
# Production: ganti ke domain sendiri yang sudah diverifikasi di resend.com/domains
# EMAIL_FROM=Bizgrow <onboarding@resend.dev>
EMAIL_FROM=Bizgrow <noreply@yourdomain.com>

# ─── WhatsApp Webhook ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_WEBHOOK_SECRET=your-wa-webhook-secret-min-32-chars

# ─── Background Jobs — Inngest ────────────────────────────────────────────────
# Dapatkan di: https://app.inngest.com
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_DEV=1  # Set ke "" di production

# ─── Payment — Midtrans ───────────────────────────────────────────────────────
# Dapatkan di: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key

# ─── Cloud Storage — Cloudflare R2 (opsional) ─────────────────────────────────
# Jika tidak diisi, foto produk disimpan lokal di /static/uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Shopee Integration (opsional) ────────────────────────────────────────────
# Konfigurasi per unit bisnis di database, bukan di .env
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Set 'true' untuk tampilkan SQL queries di console (dev only)
DB_LOGGER=false

# ─── Docker MySQL (jika pakai Docker Compose) ─────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_in_production
MYSQL_USER=bizgrow
MYSQL_PASSWORD=changeme_in_production

# ─── GitHub Actions Secrets yang diperlukan ───────────────────────────────────
# (Isi di GitHub repo → Settings → Secrets and variables → Actions)
# SSH_HOST          = IP VPS production
# SSH_USER          = user SSH (misal: ubuntu)
# SSH_PRIVATE_KEY   = private key untuk SSH ke VPS
# SSH_PORT          = port SSH (default 22)
# GITHUB_TOKEN      = otomatis tersedia di GitHub Actions
