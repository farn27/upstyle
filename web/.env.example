# ─────────────────────────────────────────────────────────────────────────────
# UPSTYLE — Environment Variables
# Salin file ini ke .env dan isi semua value yang diperlukan
# JANGAN commit file .env ke git!
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
# URL app (wajib — untuk OAuth redirect & cookie secure detection)
ORIGIN="http://localhost:5173"

# Allowed CORS origins tambahan (pisahkan dengan koma, untuk production)
# ALLOWED_ORIGINS="https://app.upstyle.id,https://mobile.upstyle.id"

# Node environment: development | production
NODE_ENV="development"

# ─── Database (WAJIB) ─────────────────────────────────────────────────────────
# Format: mysql://user:password@host:port/database_name
DATABASE_URL="mysql://root:@localhost:3306/finance_engine_db"

# ─── Session (WAJIB) ──────────────────────────────────────────────────────────
# Random string min 32 karakter — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# ─── Email via Resend (WAJIB untuk forgot password & verifikasi email) ────────
# Daftar gratis di https://resend.com (3000 email/bulan gratis)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# ─── Cloudflare R2 / S3 File Storage (WAJIB untuk production) ────────────────
# Daftar di https://dash.cloudflare.com → R2
# Tanpa ini, upload foto produk hanya tersimpan lokal (akan hilang saat redeploy)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="upstyle-uploads"
# URL publik bucket (setup Custom Domain di R2 dashboard)
R2_PUBLIC_URL="https://uploads.upstyle.id"

# ─── Payment Gateway — Midtrans (WAJIB untuk billing) ────────────────────────
# Daftar di https://midtrans.com
# Server Key ada di: Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxx"
# Client Key (public, aman di frontend)
PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxx"
# Set ke "true" untuk sandbox/testing, "false" untuk production
PUBLIC_MIDTRANS_SANDBOX="true"

# ─── AI — Groq ────────────────────────────────────────────────────────────────
# Daftar di https://console.groq.com
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxx"

# ─── WhatsApp Webhook (WAJIB jika pakai fitur WA) ────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_WEBHOOK_SECRET="ganti-dengan-secret-yang-kuat-min-32-char"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Buat di https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxx"

# ─── Pusher (Realtime) ────────────────────────────────────────────────────────
# Daftar di https://pusher.com (free tier: 200 koneksi)
PUBLIC_PUSHER_KEY="xxxxxxxxxx"
PUBLIC_PUSHER_CLUSTER="ap1"
PUSHER_APP_ID="xxxxxxxxxx"
PUSHER_SECRET="xxxxxxxxxx"

# ─── Upstash Redis (Session + Cache) ──────────────────────────────────────────
# Daftar di https://upstash.com (free tier: 10.000 req/hari)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Inngest (Background Jobs) ─────────────────────────────────────────────────
# Daftar di https://inngest.com (free tier: 50.000 events/bulan)
# Opsional - jika tidak dikonfigurasi, background job akan di-skip
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_DEV="1"  # Set ke "0" untuk production

# ─── Error Monitoring — Sentry (opsional tapi sangat direkomendasikan) ────────
# Daftar di https://sentry.io (free tier: 5.000 errors/bulan)
# SENTRY_DSN="https://xxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx"

# ─── Docker / Production Only ─────────────────────────────────────────────────
# MYSQL_ROOT_PASSWORD="ganti-dengan-password-kuat"
# MYSQL_PASSWORD="ganti-dengan-password-kuat"
